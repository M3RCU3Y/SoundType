                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="66"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="App" Foreground="{StaticResource MutedTextBrush}"/>
