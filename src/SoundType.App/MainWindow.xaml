                                                <TextBlock Text="Process name" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="ProcessRuleTextBox" Grid.Column="1" Height="44" VerticalContentAlignment="Center"/>
