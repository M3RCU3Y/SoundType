                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="154"/>
                                                    <ColumnDefinition Width="94"/>
                                                    <ColumnDefinition Width="86"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Process" Foreground="{StaticResource MutedTextBrush}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Mode" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="Pack" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="Volume" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="Last seen" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="Enabled" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
