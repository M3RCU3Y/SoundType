                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="30m" Foreground="{StaticResource MutedTextBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="25m" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="20m" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="15m" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="10m" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="Now" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </StackPanel>

