                                <TextBlock Text="Next Pack" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#151C22" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,5">
                                    <TextBlock Text="Ctrl + Alt + →" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="92"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Previous Pack" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
