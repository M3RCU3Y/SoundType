                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="20" Height="20" Margin="0,0,7,0">
                                                            <TextBlock x:Name="RuleEditorIconText" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="#35A7FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image x:Name="RuleEditorIconImage" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock x:Name="RuleEditorProcessText" Text="New rule" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
