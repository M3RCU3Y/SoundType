                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="132"/>
                                                                <ColumnDefinition Width="154"/>
                                                                <ColumnDefinition Width="94"/>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="32"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="30" Height="30" Background="Transparent" CornerRadius="4" Margin="0,0,12,0">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding ProcessIconText}" FontFamily="{Binding ProcessIconFont}" Foreground="{Binding ProcessIconForeground}" FontSize="{Binding ProcessIconFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        <Image Source="{Binding ProcessIconSource}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <TextBlock x:Name="ModeText" Grid.Column="1" Text="{Binding ModeLabel}" Foreground="{Binding ModeBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding PackDisplayName}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                            <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,20,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="42"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding VolumeText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                                <ProgressBar Grid.Column="1" Style="{StaticResource ThinProgressBarStyle}" Minimum="0" Maximum="150" Value="{Binding VolumePercent, Mode=OneWay}" VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <TextBlock Grid.Column="4" Text="{Binding LastSeenText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                            <CheckBox Grid.Column="5" IsChecked="{Binding IsEnabled, Mode=OneWay}" Style="{StaticResource KeyboardSwitchStyle}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            <TextBlock Grid.Column="6" Text="..." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Border x:Name="AppRulesEmptyState"
                                                    Grid.Row="2"
                                                    Visibility="Collapsed"
                                                    Padding="24"
                                                    Background="#10171C">
                                                <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="AppRulesEmptyTitleText" Text="No app rules yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="AppRulesEmptyDescriptionText"
                                                               Text="Create a rule for the current foreground app or type a process name in the editor."
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,18"/>
                                                    <Button Width="142" Height="38" HorizontalAlignment="Center" Click="FocusNewRule_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="+" FontSize="22" Margin="0,-3,10,0"/>
                                                            <TextBlock Text="Create Rule"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <DockPanel Grid.Row="3" Margin="18,0">
                                                <TextBlock x:Name="AppRuleSelectionText" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <Grid DockPanel.Dock="Right" Width="194" Height="32" VerticalAlignment="Center">
                                                    <TextBox x:Name="RuleSearchTextBox" Height="32" Padding="12,0,34,0" TextChanged="RuleSearchTextBox_TextChanged"/>
                                                    <TextBlock x:Name="RuleSearchPlaceholderText" Text="Search rules..." Foreground="{StaticResource SubtleTextBrush}" Margin="13,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                                                </Grid>
                                            </DockPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="RecentAppsCard" Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="48"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="128"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Recent apps" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3"
                                                        Width="128"
                                                        Height="38"
                                                        Padding="0"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        ToolTip="Create rule"
                                                        Click="FocusNewRule_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                                                            <Canvas Width="16" Height="16">
                                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="2"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      Data="M8,3 L8,13 M3,8 L13,8"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="Create Rule" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <ScrollViewer Grid.Column="1"
                                                              Margin="12,0,0,0"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Disabled">
                                                    <ListBox x:Name="RecentAppsList"
                                                             BorderThickness="0"
                                                             Height="40"
                                                             ItemContainerStyle="{StaticResource RecentAppChipItemStyle}"
                                                             SelectionChanged="RecentAppsList_SelectionChanged">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Grid Width="20" Height="20" Margin="0,0,7,0">
                                                                        <TextBlock Text="{Binding IconText}" FontFamily="{Binding IconFont}" Foreground="{Binding IconForeground}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        <Image Source="{Binding IconSource}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="71"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </ScrollViewer>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.45*"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="0.85*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,12">
                                                        <TextBlock Text="App switch activity" FontWeight="SemiBold"/>
                                                        <TextBlock Text="(last 30 minutes)" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0"/>
                                                    </DockPanel>
                                                    <Grid Height="92">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="1"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="1"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="1"/>
                                                        </Grid.RowDefinitions>
                                                        <Rectangle Fill="#2C353D"/>
                                                        <Rectangle Grid.Row="2" Fill="#2C353D"/>
                                                        <Rectangle Grid.Row="4" Fill="#2C353D"/>
