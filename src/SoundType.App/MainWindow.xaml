                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="10"/>
                                                                        <ColumnDefinition Width="58"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding IconText}" FontFamily="{Binding IconFont}" Foreground="{Binding IconForeground}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        <Image Source="{Binding IconSource}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <Ellipse Grid.Column="2" Width="5" Height="5" Fill="{Binding DotBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding LastSeenText}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
